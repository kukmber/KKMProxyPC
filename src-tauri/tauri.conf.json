{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KKMProxy",
  "version": "0.2.0",
  "identifier": "io.github.kukmber.kkmproxypc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KKMProxy",
        "width": 1040,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzQzU2QzkxMUM0OEI4RUQKUldUdHVFZ2NrV3pGNHkxSnBHZlVkVEFvMlQvS3o3Y2ZSclozZ3h1NVlYT01VQWN1VmozUGpMV2gK",
      "endpoints": [
        "https://github.com/kukmber/KKMProxyPC/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
